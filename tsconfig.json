{
  "compilerOptions": {
    "rootDir": "src",
    "target": "ESNext",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "declarationDir": "dist/types",
    "module": "ESNext",
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}